# Signal Engine HTTP server
PORT=8787
FATEDROP_SIGNAL_API_TOKEN=replace-with-a-long-random-read-token
FATEDROP_SIGNAL_INGEST_SECRET=replace-with-a-long-random-admin-token

# Storage. Use file for Codespaces/dev and postgres in hosted production.
FATEDROP_SIGNAL_STORE=file
FATEDROP_SIGNAL_FILE=data/signal-engine.json
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Fate Encounters / Local Radar. Keep the Google Places key server-side only.
# Restrict the key in Google Cloud to the Places API and the hosted FateDrop backend.
# GOOGLE_PLACES_API_KEY=replace-with-restricted-server-key

# Dynamic retailer registry. Keep OFF until the additive registry migration is deliberately applied
# and monitored retailer rows have completed qualification/dry-run approval.
FATEDROP_RETAILER_REGISTRY_ENABLED=false

# Hosted FateFind/FateMatch evaluator. An explicit false remains the production kill switch.
FATEDROP_HOSTED_FATEFIND_ENABLED=false
FATEDROP_HOSTED_FATEFIND_MAX_PER_RUN=2000
FATEDROP_NOTIFICATION_BATCH_SIZE=100
# EXPO_ACCESS_TOKEN=optional-expo-access-token

# Scan scheduler. V1 deliberately uses conservative polling.
FATEDROP_SCAN_INTERVAL_SECONDS=300
FATEDROP_SCAN_ON_START=false
FATEDROP_SCAN_CONCURRENCY=2
FATEDROP_FETCH_TIMEOUT_MS=15000
FATEDROP_FETCH_USER_AGENT=FateDrop/0.1 (+https://fate-drop.com; catalogue-monitor)

# First successful scan is a quiet baseline so existing stock does not create thousands of alerts.
FATEDROP_SUPPRESS_BASELINE_SIGNALS=true

# Discord signal delivery. Each lifecycle can use its own companion bot identity and channel.
# The legacy DISCORD_BOT_TOKEN and premium channel remain safe fallbacks during migration.
FATEDROP_DISCORD_ENABLED=false
# DISCORD_BOT_TOKEN=optional-legacy-fallback-bot-token
# DISCORD_ORU_BOT_TOKEN=oru-whisper-bot-token
# DISCORD_FENN_BOT_TOKEN=fenn-echo-bot-token
# DISCORD_KORU_BOT_TOKEN=koru-manifested-and-fatematch-bot-token
# DISCORD_NIXON_BOT_TOKEN=nixon-vanished-bot-token
# DISCORD_PREMIUM_DROPS_CHANNEL_ID=optional-fallback-channel-id
# DISCORD_WHISPER_CHANNEL_ID=oru-whisper-channel-id
# DISCORD_ECHO_CHANNEL_ID=fenn-echo-channel-id
# DISCORD_MANIFESTED_CHANNEL_ID=koru-manifested-channel-id
# DISCORD_VANISHED_CHANNEL_ID=nixon-vanished-channel-id

# Website dashboard snapshot publishing. The same secret must be configured as
# FATEDROP_METRICS_INGEST_SECRET on the FateDrop website runtime.
# FATEDROP_WEBSITE_SNAPSHOT_URL=https://your-fatedrop-site.example/api/dashboard/network-snapshot
# FATEDROP_METRICS_INGEST_SECRET=replace-with-a-long-random-shared-secret

# Static/launch retailer coverage. Each source fails closed independently if it blocks/rate-limits
# catalogue access, so one retailer cannot take down the rest of the network.
FATEDROP_RETAILER_POKEMON_CENTER_UK=true
FATEDROP_RETAILER_SMYTHS_UK=true
FATEDROP_RETAILER_CHAOS_CARDS=true
FATEDROP_RETAILER_HAMLEYS_UK=true
FATEDROP_RETAILER_ASDA_UK=true
FATEDROP_RETAILER_TESCO_UK=true
FATEDROP_RETAILER_ENTERTAINER_UK=true
FATEDROP_RETAILER_GAME_UK=true
FATEDROP_RETAILER_ARGOS_UK=true
FATEDROP_RETAILER_MAGIC_MADHOUSE=true
FATEDROP_RETAILER_DOUBLE_SLEEVED=true
FATEDROP_RETAILER_TOTAL_CARDS=true
FATEDROP_RETAILER_TITAN_CARDS=true
FATEDROP_RETAILER_ETERNA_CARDS=true
FATEDROP_RETAILER_CARD_COLLECTIVE=true
FATEDROP_RETAILER_JET_CARDS=true
FATEDROP_RETAILER_GATHERING_GAMES=true
FATEDROP_RETAILER_ZATU_GAMES=true
FATEDROP_RETAILER_TGC_COLLECTABLES=true

# Amazon UK is intentionally OFF. FateDrop must use approved Amazon Associates/Creators API access,
# and Amazon Product Advertising Content needs a retention/refresh path compatible with Amazon's
# current licence before it may enter the normal monitoring runtime. Never scrape around this gate.
FATEDROP_RETAILER_AMAZON_UK=false
# AMAZON_CREATORS_CLIENT_ID=server-side-creators-api-client-id
# AMAZON_CREATORS_CLIENT_SECRET=server-side-creators-api-client-secret
# AMAZON_CREATORS_PARTNER_TAG=your-uk-associates-tracking-id
