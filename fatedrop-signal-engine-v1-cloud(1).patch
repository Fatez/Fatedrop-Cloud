+FATEDROP_SIGNAL_FILE=data/signal-engine.json
+# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
+
+# Scan scheduler. V1 deliberately uses conservative polling.
+FATEDROP_SCAN_INTERVAL_SECONDS=300
+FATEDROP_SCAN_ON_START=false
+FATEDROP_SCAN_CONCURRENCY=2
+FATEDROP_FETCH_TIMEOUT_MS=15000
+FATEDROP_FETCH_USER_AGENT=FateDrop/0.1 (+https://fate-drop.com; catalogue-monitor)
+
