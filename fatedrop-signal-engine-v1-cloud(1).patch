+FATEDROP_SUPPRESS_BASELINE_SIGNALS=true
+
+# Retailers. Disable any source that blocks catalogue monitoring rather than bypassing protections.
+FATEDROP_RETAILER_POKEMON_CENTER_UK=true
+FATEDROP_RETAILER_SMYTHS_UK=true
+FATEDROP_RETAILER_CHAOS_CARDS=true
