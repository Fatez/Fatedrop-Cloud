FATEDROP_CHROME_CDP_URL=http://127.0.0.1:9222
FATEDROP_POKEMON_CATALOGUE_URL=https://www.pokemoncenter.com/en-gb/search/tcg-cards
FATEDROP_SIGNAL_INGEST_URL=http://127.0.0.1:8787/internal/ingest
FATEDROP_NETWORK_STATE_URL=http://127.0.0.1:8787/internal/network-state
FATEDROP_SIGNAL_INGEST_SECRET=
FATEDROP_COLLECTOR_RESPONSE_TIMEOUT_MS=30000

# Long-running supervised mode enforces these as safe minimums. You may raise
# them further, but values below 5 minutes / 4 seconds are clamped upward by
# the supervisor to reduce repeated catalogue pressure and IP lockout risk.
FATEDROP_COLLECTOR_CYCLE_MS=300000
FATEDROP_COLLECTOR_SETTLE_MS=4000

# Self-healing / backoff. Queue, security and access-block evidence always
# pauses retries instead of attempting to bypass retailer controls.
FATEDROP_COLLECTOR_RESTART_BASE_MS=60000
FATEDROP_COLLECTOR_RESTART_MAX_MS=1800000
FATEDROP_COLLECTOR_STABLE_RUNTIME_MS=1200000
FATEDROP_COLLECTOR_REPEATED_FAILURE_COOLDOWN_MS=600000
FATEDROP_COLLECTOR_QUEUE_COOLDOWN_MS=300000
FATEDROP_COLLECTOR_SECURITY_COOLDOWN_MS=900000
FATEDROP_COLLECTOR_ACCESS_BLOCK_COOLDOWN_MS=3600000
