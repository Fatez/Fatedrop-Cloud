+import type { Metadata } from "next";
+import Link from "next/link";
+import { redirect } from "next/navigation";
+import { LiveAlerts } from "@/components/live-alerts";
+import { getCurrentSnapshot } from "@/lib/auth";
+import { getSignalEngineNetwork, getSignalEngineSignals } from "@/lib/signal-engine";
+
+export const metadata: Metadata = {
+  title: "Alerts | FateDrop",
+  description: "Your live FateDrop stock lifecycle signal feed.",
+  robots: { index: false, follow: false },
+};
+
+function metric(value: number | null | undefined) {
+  return value == null ? "—" : new Intl.NumberFormat("en-GB").format(value);
+}
+
+export default async function AlertsPage() {
+  const snapshot = await getCurrentSnapshot();
+  if (!snapshot) redirect("/account/login?next=/alerts");
+
+  const [networkResult, signalResult] = await Promise.all([
+    getSignalEngineNetwork(),
+    getSignalEngineSignals({ limit: 120 }),
+  ]);
+  const network = networkResult.ok ? networkResult.data : null;
+  const signals = signalResult.ok ? signalResult.data.signals : [];
+  const configured = networkResult.configured || signalResult.configured;
+
+  return <main className="signal-alerts-page">
+    <section className="signal-alerts-hero">
+      <div>
+        <p className="eyebrow"><span />FateDrop Intelligence</p>
+        <h1>Alerts built from the network,<br /><em>not from guesswork.</em></h1>
+        <p>Whisper, Manifested, Vanished and Echo are generated by persisted retailer observations in FateDrop Signal Engine V1. The web and mobile app will consume the same signal record.</p>
+        <div className="signal-alerts-hero-actions"><Link className="button button-secondary" href="/dashboard">Back to dashboard</Link><Link className="button button-primary" href="/account">My FateDrop ID <span>↗</span></Link></div>
+      </div>
+      <aside className="signal-alerts-network-card">
+        <span>NETWORK · LAST 24H</span>
+        <div><strong>{metric(network?.stats.manifested24h)}</strong><small>Manifested</small></div>
+        <div><strong>{metric(network?.stats.echo24h)}</strong><small>Echo</small></div>
+        <div><strong>{metric(network?.stats.vanished24h)}</strong><small>Vanished</small></div>
+        <div><strong>{metric(network?.stats.whisper24h)}</strong><small>Whisper</small></div>
+        <footer>{network ? `${network.retailers.filter((item) => item.healthy).length}/${network.retailers.length} monitors healthy` : "Awaiting Signal Engine"}</footer>
+      </aside>
+    </section>
+
+    <section className="signal-alerts-feed-section">
+      <div className="section-heading split-heading"><div><p className="eyebrow"><span />Live lifecycle feed</p><h2>The signal stream.</h2></div><p>Every card links back to the retailer evidence that caused the state transition. Unknown delivery costs stay unknown until FateDrop has an evidence-backed postage rule.</p></div>
+      <LiveAlerts initialSignals={signals} retailers={network?.retailers ?? []} connected={networkResult.ok && signalResult.ok} configured={configured} initialGeneratedAt={signalResult.ok ? signalResult.data.generatedAt : null} />
+    </section>
+  </main>;
+}
diff --git a/app/api/signals/route.ts b/app/api/signals/route.ts
new file mode 100644
index 0000000..92e258e
--- /dev/null
+++ b/app/api/signals/route.ts
@@ -0,0 +1,28 @@
+import { NextResponse } from "next/server";
+import { getCurrentSnapshot } from "@/lib/auth";
+import { getSignalEngineSignals } from "@/lib/signal-engine";
+
+const allowedStates = new Set(["whisper", "manifested", "vanished", "echo"]);
+
+export async function GET(request: Request) {
+  const snapshot = await getCurrentSnapshot();
+  if (!snapshot) return NextResponse.json({ error: "Sign in required." }, { status: 401 });
+
+  const url = new URL(request.url);
+  const states = (url.searchParams.get("state") || "")
+    .split(",")
+    .map((value) => value.trim())
+    .filter((value) => allowedStates.has(value));
+  const retailerIds = (url.searchParams.get("retailer") || "")
+    .split(",")
+    .map((value) => value.trim())
+    .filter(Boolean)
+    .slice(0, 20);
+  const limit = Math.min(150, Math.max(1, Number.parseInt(url.searchParams.get("limit") || "100", 10) || 100));
+
+  const result = await getSignalEngineSignals({ states, retailerIds, limit });
+  if (!result.ok) {
+    return NextResponse.json({ connected: false, configured: result.configured, error: result.error, signals: [] }, { status: result.configured ? 503 : 200 });
+  }
+  return NextResponse.json({ connected: true, generatedAt: result.data.generatedAt, signals: result.data.signals });
+}
