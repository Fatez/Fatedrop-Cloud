+export type SignalLifecycle = "whisper" | "manifested" | "vanished" | "echo";
+
+export type SignalEngineSignal = {
+  id: string;
+  state: SignalLifecycle;
+  productId: string;
+  offerId: string;
+  retailerId: string;
+  retailerName: string;
+  title: string;
+  productType: string;
+  url: string;
+  imageUrl: string | null;
+  pricePence: number | null;
+  rrpPence: number | null;
+  postagePence: number | null;
+  deliveredPricePence: number | null;
+  markupPercent: number | null;
+  stockStatus: string;
+  previousStockStatus: string | null;
+  confidence: number;
+  detectedAt: number;
+  reason: string;
+  evidence: Array<{ kind?: string; value?: string; pageUrl?: string }>;
+};
+
+export type SignalEngineRetailer = {
+  id: string;
+  name: string;
+  healthy: boolean;
+  lastScanAt: number | null;
+  lastSuccessAt?: number | null;
+  lastError?: string | null;
+  productsSeen?: number;
+  pagesScanned?: number;
+  baselineCompleted?: boolean;
+};
+
+export type SignalEngineMetrics = {
+  productsTracked: number;
+  offersTracked: number;
+  currentlyAvailable: number;
+  signals24h: number;
+  manifested24h: number;
+  echo24h: number;
+  vanished24h: number;
+  whisper24h: number;
+};
+
+export type SignalEngineNetwork = {
+  generatedAt: number;
+  stats: SignalEngineMetrics;
+  retailers: SignalEngineRetailer[];
+};
+
+export type SignalEngineHistorySnapshot = {
+  id: string;
+  measuredAt: number;
+  metrics: SignalEngineMetrics;
+  retailers: SignalEngineRetailer[];
+};
+
+export type SignalEngineResult<T> =
+  | { ok: true; configured: true; data: T }
+  | { ok: false; configured: boolean; error: string };
+
+function baseUrl() {
+  return (process.env.FATEDROP_SIGNAL_ENGINE_URL || "").replace(/\/$/, "");
+}
+
+async function request<T>(path: string): Promise<SignalEngineResult<T>> {
+  const base = baseUrl();
+  if (!base) return { ok: false, configured: false, error: "FateDrop Signal Engine is not configured." };
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), 6000);
+  try {
+    const headers: HeadersInit = { accept: "application/json" };
+    const token = process.env.FATEDROP_SIGNAL_API_TOKEN;
+    if (token) headers.authorization = `Bearer ${token}`;
+    const response = await fetch(`${base}${path}`, { headers, cache: "no-store", signal: controller.signal });
+    if (!response.ok) return { ok: false, configured: true, error: `Signal Engine returned ${response.status}.` };
+    return { ok: true, configured: true, data: await response.json() as T };
+  } catch (error) {
+    return { ok: false, configured: true, error: error instanceof Error ? error.message : "Signal Engine request failed." };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export function getSignalEngineNetwork() {
+  return request<SignalEngineNetwork>("/v1/network");
+}
+
+export function getSignalEngineHistory(limit = 30) {
+  const safe = Math.min(180, Math.max(1, limit));
+  return request<{ snapshots: SignalEngineHistorySnapshot[] }>(`/v1/network/history?limit=${safe}`);
+}
+
+export function getSignalEngineSignals(input: { states?: string[]; retailerIds?: string[]; since?: number; limit?: number } = {}) {
+  const params = new URLSearchParams();
+  if (input.states?.length) params.set("state", input.states.join(","));
+  if (input.retailerIds?.length) params.set("retailer", input.retailerIds.join(","));
+  if (input.since) params.set("since", String(input.since));
+  params.set("limit", String(Math.min(250, Math.max(1, input.limit ?? 100))));
+  return request<{ generatedAt: number; signals: SignalEngineSignal[] }>(`/v1/signals?${params.toString()}`);
+}
