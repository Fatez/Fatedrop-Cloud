+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import type { SignalEngineRetailer, SignalEngineSignal, SignalLifecycle } from "@/lib/signal-engine";
+import styles from "./live-alerts.module.css";
+
+type Props = {
+  initialSignals: SignalEngineSignal[];
+  retailers: SignalEngineRetailer[];
+  connected: boolean;
+  configured: boolean;
+  initialGeneratedAt: number | null;
+};
+
+const states: Array<{ value: "all" | SignalLifecycle; label: string }> = [
+  { value: "all", label: "All signals" },
+  { value: "manifested", label: "Manifested" },
+  { value: "echo", label: "Echo" },
+  { value: "whisper", label: "Whisper" },
+  { value: "vanished", label: "Vanished" },
+];
+
+function money(value: number | null) {
+  return value == null ? null : new Intl.NumberFormat("en-GB", { style: "currency", currency: "GBP" }).format(value / 100);
+}
+function age(timestamp: number) {
+  const seconds = Math.max(0, Math.floor(Date.now() / 1000) - timestamp);
+  if (seconds < 60) return `${seconds}s ago`;
+  if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
+  if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
+  return `${Math.floor(seconds / 86400)}d ago`;
+}
+function glyph(state: SignalLifecycle) {
+  return state === "manifested" ? "M" : state === "whisper" ? "W" : state === "echo" ? "E" : "V";
+}
+
+export function LiveAlerts({ initialSignals, retailers, connected: initiallyConnected, configured, initialGeneratedAt }: Props) {
+  const [signals, setSignals] = useState(initialSignals);
+  const [state, setState] = useState<"all" | SignalLifecycle>("all");
+  const [retailer, setRetailer] = useState("all");
+  const [query, setQuery] = useState("");
+  const [connected, setConnected] = useState(initiallyConnected);
+  const [generatedAt, setGeneratedAt] = useState(initialGeneratedAt);
+  const [loading, setLoading] = useState(false);
+
+  useEffect(() => {
+    let cancelled = false;
+    const refresh = async () => {
+      setLoading(true);
+      const params = new URLSearchParams({ limit: "120" });
+      if (state !== "all") params.set("state", state);
+      if (retailer !== "all") params.set("retailer", retailer);
+      try {
+        const response = await fetch(`/api/signals?${params.toString()}`, { cache: "no-store" });
+        const body = await response.json();
+        if (cancelled) return;
+        setConnected(Boolean(body.connected));
+        if (body.connected) {
+          setSignals(Array.isArray(body.signals) ? body.signals : []);
+          setGeneratedAt(typeof body.generatedAt === "number" ? body.generatedAt : null);
+        }
+      } catch {
+        if (!cancelled) setConnected(false);
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    };
+    refresh();
+    const timer = window.setInterval(refresh, 20_000);
+    return () => { cancelled = true; window.clearInterval(timer); };
+  }, [state, retailer]);
+
+  const visible = useMemo(() => {
+    const q = query.trim().toLowerCase();
+    return q ? signals.filter((signal) => `${signal.title} ${signal.retailerName}`.toLowerCase().includes(q)) : signals;
+  }, [signals, query]);
+
+  return (
+    <div className={`${styles.shell}${loading ? ` ${styles.loading}` : ""}`}>
+      <div className={styles.toolbar}>
+        <div className={styles.states} role="group" aria-label="Signal lifecycle filter">
+          {states.map((item) => <button type="button" key={item.value} className={state === item.value ? styles.active : ""} onClick={() => setState(item.value)}>{item.label}</button>)}
+        </div>
+        <select className={styles.select} aria-label="Retailer filter" value={retailer} onChange={(event) => setRetailer(event.target.value)}>
+          <option value="all">All monitored retailers</option>
+          {retailers.map((item) => <option value={item.id} key={item.id}>{item.name}</option>)}
+        </select>
+      </div>
+
+      <input className={styles.search} value={query} onChange={(event) => setQuery(event.target.value)} placeholder="Filter this signal feed by product or retailer…" aria-label="Filter signal feed" />
+
+      <div className={styles.status}>
+        <strong><span className={`${styles.dot}${connected ? "" : ` ${styles.offline}`}`} />{connected ? "FateDrop Signal Engine connected" : configured ? "Signal Engine temporarily unavailable" : "Signal Engine not connected yet"}</strong>
+        <span>{generatedAt ? `Feed refreshed ${age(generatedAt)}` : "No generated feed timestamp"}</span>
+      </div>
+
+      {visible.length ? <div className={styles.grid}>
+        {visible.map((signal) => {
+          const listed = money(signal.pricePence);
+          const delivered = money(signal.deliveredPricePence);
+          const rrp = money(signal.rrpPence);
+          return <article className={`${styles.card} ${styles[signal.state]}`} key={signal.id}>
+            <span className={styles.glyph} aria-hidden="true">{glyph(signal.state)}</span>
+            <div className={styles.body}>
+              <div className={styles.meta}><span className={styles.state}>{signal.state}</span><span className={styles.retailer}>{signal.retailerName}</span><span className={styles.time}>{age(signal.detectedAt)}</span></div>
+              <h3>{signal.title}</h3>
+              <p className={styles.reason}>{signal.reason}</p>
+            </div>
+            <div className={styles.price}>
+              <strong>{delivered || listed || "Price pending"}</strong>
+              <span>{delivered ? "verified delivered price" : listed ? "listed price · delivery unverified" : "retailer price unavailable"}</span>
+              {rrp ? <em>RRP {rrp}{signal.markupPercent != null ? ` · ${signal.markupPercent >= 0 ? "+" : ""}${signal.markupPercent}%` : ""}</em> : null}
+            </div>
+            <footer className={styles.bottom}><span className={styles.evidence}>{Math.round(signal.confidence * 100)}% observation confidence · {signal.stockStatus.replaceAll("_", " ")}</span><a className={styles.open} href={signal.url} target="_blank" rel="noreferrer">Open retailer <span aria-hidden="true">↗</span></a></footer>
+          </article>;
+        })}
+      </div> : <div className={styles.empty}><strong>{connected ? "No matching signals yet." : "The Alerts page is ready for the engine."}</strong><p>{connected ? "FateDrop is monitoring the selected lifecycle and retailer filters. New state changes will appear here automatically." : configured ? "The website can reach the Signal Engine configuration, but its service is currently offline or unavailable." : "Set FATEDROP_SIGNAL_ENGINE_URL and the shared API token once Signal Engine V1 is running. Until then FateDrop will not invent alert data."}</p></div>}
+    </div>
+  );
+}
