+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+
+test("authenticated alerts page consumes Signal Engine and does not embed sample alerts", () => {
+  const page = fs.readFileSync("app/alerts/page.tsx", "utf8");
+  const client = fs.readFileSync("lib/signal-engine.ts", "utf8");
+  const api = fs.readFileSync("app/api/signals/route.ts", "utf8");
+  assert.match(page, /getSignalEngineSignals/);
+  assert.match(page, /redirect\("\/account\/login\?next=\/alerts"\)/);
+  assert.match(client, /FATEDROP_SIGNAL_ENGINE_URL/);
+  assert.match(api, /getCurrentSnapshot/);
+  assert.doesNotMatch(page, /Example ETB|sample signal|fake signal/i);
+});
